{
  "name": "excel-strict-searcher",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/serve-dist.mjs --dev",
    "dev:web": "vite",
    "quickstart": "vite --host 127.0.0.1 --port 4174",
    "build": "tsc -b && vite build",
    "preview": "node scripts/serve-dist.mjs",
    "package:portable-runtime": "npm run build && node scripts/package-portable-runtime.mjs",
    "package:portable-exe": "npm run build && node scripts/package-portable-exe.mjs",
    "package:windows-installer": "npm run build && node scripts/package-windows-installer.mjs",
    "package:github-release": "node scripts/sync-github-release.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
